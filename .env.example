# Runtime
NODE_ENV=development
PORT=3090
BASE_DOMAIN=collabify.local

# Storage Adapter: 'memory' (zero-dependency RLS simulator) or 'postgres' (real pg + RLS)
STORAGE_MODE=memory

# PostgreSQL (separate non-superuser runtime role vs migrator role)
DATABASE_URL=postgres://collabify_app:replace_with_app_password@localhost:6432/collabify
DATABASE_MIGRATOR_URL=postgres://collabify_migrator:replace_with_migrator_password@localhost:5432/collabify

# Cryptographic Signing Secrets (generate 32+ random bytes in production)
AUTH_SIGNING_SECRET=replace_with_32_byte_random_hex_for_jwt_signing
UPLOAD_SIGNING_SECRET=replace_with_32_byte_random_hex_for_part_signing

# Reverse Proxy Trust Boundary (comma-separated IPs allowed to send X-Forwarded-Host)
# Leave empty unless running behind Cloudflare / ALB / Nginx
TRUSTED_PROXY_IPS=

# Demo UI convenience header (strictly ignored when NODE_ENV=production)
ALLOW_DEMO_HOST_HEADER=true

# Optional S3 / Cloudflare R2 settings for production multipart presigner
S3_BUCKET=collabify-media-prod
S3_REGION=auto
S3_ENDPOINT=https://replace_account_id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=replace_with_r2_access_key
S3_SECRET_ACCESS_KEY=replace_with_r2_secret_key
