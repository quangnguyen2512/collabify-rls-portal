{
  "name": "collabify-multitenant-reference",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Collabify Reference App: PostgreSQL Shared-Schema RLS, Subdomain Client Portals, Dual Auth Flows, and Resumable Multipart Video Uploads",
  "scripts": {
